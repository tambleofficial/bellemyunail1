{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bellemyunail",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "vars": {
    "GITHUB_OWNER": "tambleofficial",
    "GITHUB_REPO": "bellemyunail1",
    "GITHUB_BRANCH": "main"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/admin",
      "/admin/*",
      "/robots.txt",
      "/sitemap.xml"
    ]
  }
}
