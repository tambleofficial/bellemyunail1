{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bellemyunail",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/admin",
      "/admin/*",
      "/media/*",
      "/api/media-manifest",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "bellemyunail-media"
    }
  ]
}
